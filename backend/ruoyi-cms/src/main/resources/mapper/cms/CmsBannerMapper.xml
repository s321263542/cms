<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cms.mapper.CmsBannerMapper">

    <resultMap id="CmsBannerResult" type="com.ruoyi.cms.domain.CmsBanner">
        <id     column="id"           property="id"/>
        <result column="position"     property="position"/>
        <result column="poster_type"  property="posterType"/>
        <result column="image_url"    property="imageUrl"/>
        <result column="tag"          property="tag"/>
        <result column="title"        property="title"/>
        <!-- 列名 desc 是 SQL 关键字：SELECT 里用 `desc` 反引号包，但 resultMap 的
             column 只能写结果集标签名（不带反引号），否则匹配不上 → 恒为 null -->
        <result column="desc"         property="desc"/>
        <result column="price_text"   property="priceText"/>
        <result column="button_text"  property="buttonText"/>
        <result column="button_link"  property="buttonLink"/>
        <result column="sort_order"   property="sortOrder"/>
        <result column="status"       property="status"/>
        <result column="i18n_json"    property="i18nJson"
                javaType="java.lang.Object"
                typeHandler="com.ruoyi.cms.handler.JsonTypeHandler"/>
    </resultMap>

    <!-- 刻意不查 ext_json：轮播的扩展字段属于后台，前台接口不下发 -->
    <select id="selectPublicList" resultMap="CmsBannerResult">
        SELECT id, position, poster_type, image_url, tag, title, `desc`, price_text,
               button_text, button_link, sort_order, status, i18n_json
        FROM cms_banner
        WHERE is_deleted = 0 AND status = 1 AND live_flag = 1
          AND position = #{position}
        ORDER BY sort_order ASC
    </select>

</mapper>
