<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cms.mapper.CmsCountryMapper">

    <!-- 全局关闭了 mapUnderscoreToCamelCase，列名到属性必须逐列显式声明 -->
    <resultMap id="CmsCountryResult" type="com.ruoyi.cms.domain.CmsCountry">
        <id     column="id"         property="id"/>
        <result column="code"       property="code"/>
        <result column="name"       property="name"/>
        <result column="en_name"    property="enName"/>
        <result column="icon_url"   property="iconUrl"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="status"     property="status"/>
    </resultMap>

    <select id="selectPublicList" resultMap="CmsCountryResult">
        SELECT id, code, name, en_name, icon_url, sort_order, status
        FROM cms_country
        WHERE is_deleted = 0 AND status = 1
        ORDER BY sort_order ASC
    </select>

</mapper>
