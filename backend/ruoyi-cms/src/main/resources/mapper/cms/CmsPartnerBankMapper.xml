<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cms.mapper.CmsPartnerBankMapper">

    <resultMap id="CmsPartnerBankResult" type="com.ruoyi.cms.domain.CmsPartnerBank">
        <id     column="id"           property="id"/>
        <result column="country_id"   property="countryId"/>
        <result column="name"         property="name"/>
        <result column="en_name"      property="enName"/>
        <result column="logo_url"     property="logoUrl"/>
        <result column="features"     property="features"/>
        <result column="success_rate" property="successRate"/>
        <result column="sort_order"   property="sortOrder"/>
        <result column="status"       property="status"/>
        <result column="ext_json"     property="extJson"
                javaType="java.lang.Object"
                typeHandler="com.ruoyi.cms.handler.JsonTypeHandler"/>
        <result column="i18n_json"    property="i18nJson"
                javaType="java.lang.Object"
                typeHandler="com.ruoyi.cms.handler.JsonTypeHandler"/>
    </resultMap>

    <select id="selectPublicList" resultMap="CmsPartnerBankResult">
        SELECT id, country_id, name, en_name, logo_url, features, success_rate,
               sort_order, status, ext_json, i18n_json
        FROM cms_partner_bank
        WHERE is_deleted = 0 AND status = 1 AND live_flag = 1
        ORDER BY sort_order ASC
    </select>

</mapper>
