<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.cms.mapper.CmsSiteConfigMapper">

    <resultMap id="CmsSiteConfigResult" type="com.ruoyi.cms.domain.CmsSiteConfig">
        <id     column="id"           property="id"/>
        <result column="config_key"   property="configKey"/>
        <result column="config_name"  property="configName"/>
        <result column="config_value" property="configValue"/>
        <result column="value_type"   property="valueType"/>
        <result column="group_name"   property="groupName"/>
        <result column="lang"         property="lang"/>
        <result column="is_public"    property="isPublic"/>
        <result column="sort_order"   property="sortOrder"/>
        <result column="status"       property="status"/>
    </resultMap>

    <!-- is_public=0 的键（turnstile_site_key）永不进公网响应 -->
    <select id="selectPublicList" resultMap="CmsSiteConfigResult">
        SELECT id, config_key, config_name, config_value, value_type, group_name,
               lang, is_public, sort_order, status
        FROM cms_site_config
        WHERE is_deleted = 0 AND status = 1 AND live_flag = 1 AND is_public = 1
        ORDER BY sort_order ASC
    </select>

</mapper>
