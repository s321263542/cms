# ---------------------------------------------------------------------------
# 永鸿国际出海企服 CMS · 前台 Nuxt 4 环境配置（复制为 .env 后按需修改）
# ---------------------------------------------------------------------------

# 公网只读 API 的前缀。
#   留空      = 使用本项目自带的 mock 接口（server/api/public/**），开箱即用
#   拉起若依后 = 填后端地址，例如 https://www.example.com/api
#   切换只需改这一处，组件代码零改动。
NUXT_PUBLIC_API_BASE=""

# 站点对外域名（生成 sitemap / 绝对链接时用）
NUXT_PUBLIC_SITE_URL="http://localhost:3000"

# 开发期可写死 CDN 根（最终以 /api/public/config 下发的 cdn_base 为准）
NUXT_PUBLIC_CDN_BASE=""
