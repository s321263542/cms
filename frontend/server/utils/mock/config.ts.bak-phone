/**
 * cms_site_config 的 mock —— 每个 config_key 有 zh / en 两行（对应 uk_config_key_lang）。
 * 真实后端上线后整份文件可删。
 *
 * ⚠️ 相对《数据库表设计.md》预置 SQL 的差异（详见 README「配置键差异」）：
 *   · 新增 home_service      —— 首页「核心出海业务矩阵」专区标题/副标题
 *   · home_rec 增加 sub 字段
 *   · home_process.steps 增加 time 字段
 *   · cs_quick_tags 由字符串数组改为 {emoji,label,question} 对象数组
 *   · 预置值改用原型里的真实工商信息（原 SQL 是占位符）
 */

export interface ConfigSeed {
  config_key: string
  config_name: string
  value_type: 'string' | 'number' | 'boolean' | 'json' | 'image' | 'color'
  group_name: 'base' | 'seo' | 'home' | 'footer' | 'cs'
  is_public: 0 | 1
  remark?: string
  zh: any
  en: any
}

