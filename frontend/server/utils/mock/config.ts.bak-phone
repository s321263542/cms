/** 取某语言的配置快照，缺失键回退 zh */
export function configFor(lang: string): Record<string, any> {
  const out: Record<string, any> = {}
  for (const seed of configSeeds) {
    if (seed.is_public === 0) continue // 仅后台可见，不下发公网 API
    const value = lang === 'zh' ? seed.zh : (seed.en ?? seed.zh)
    out[seed.config_key] = value
  }
  return out
}
